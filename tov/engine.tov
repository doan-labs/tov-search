// tov-search: whole-disk file search. The engine was ported to Tov from the
// reference engine that wrote bench/oracle (src/{index,live,query}.rs at
// 04a402e). Named tov-search, this is the app (src/app.tov); named engine*,
// it speaks bench/PROTOCOL.md:
//
//   engine <disk-file> [home [linux]]   build the index, print "ready", answer one query per stdin line
//
// home and linux set what `~` means and the Linux folder ranking, for disk
// files of real disks (the benchmark's home is /Users/bench).
//
// The modules in src/ hold the engine by concern. The operating system calls
// Tov has no API for are `// hook(raw):` functions (src/io.tov, src/scan.tov,
// realPath): inject.py pastes their C bodies from kernels/io/ over them.
// Every other `// hook:` function has a pure-Tov body that is the reference,
// and an optional C kernel in kernels/ to race it. Its `reads:` and `writes:`
// lines are the globals that kernel gets; see inject.py for the contract and
// build/hooks.h for the prototypes.

import { home, setHome } from "./src/consts"
import { enc } from "./src/bytes"
import { readDisk } from "./src/disk"
import { setLinuxPriors } from "./src/prior"
import { build, putPath } from "./src/index"
import { Query, parse, emptyQuery } from "./src/query"
import { namesAlloc } from "./src/names"
import { memosAlloc } from "./src/memos"
import { extIndexBuild } from "./src/exts"
import { topScore, topIdx } from "./src/topk"
import { search } from "./src/search"
import { readLine, writeOut } from "./src/io"
import { liveReset, applyDir, liveSearch, hitScore, hitIdx, hitPath, deadCount, overCount } from "./src/live"
import { contentOpen } from "./src/segs"
import { syncNow } from "./src/content"
import { inScope } from "./src/cscope"
import { grepSet, setBudget } from "./src/grep"
import { contentSearch, scanSearch, scanPaths, resPaths, resLineAt, resLineNo, resLineText, resCandidates,
  resComplete } from "./src/csearch"
import { cli } from "./src/app"

let out: u8[] = []

function put(s: string): void {
  for (const c of enc(s)) {
    out.push(c)
  }
}

// A content search's answer: candidates and whether all were read, then per
// file its path and its lines (number, tab, text), then an empty line.
function answerGrep(q: Query): void throws Error {
  if (grepSet(q.grep, q.grepMode) !== "") {
    writeOut(enc("error\n\n"))
    return
  }
  setBudget(0)
  if (!q.hasScope || inScope(q.scope, enc(home))) {
    contentSearch(q)
  } else {
    scanSearch(scanPaths(q), q.limit)
  }
  put(`${resCandidates} ${resComplete}\n`)
  for (let f = 0; f < resPaths.length; f++) {
    for (const c of resPaths[f]!) {
      out.push(c)
    }
    out.push(u8(10))
    for (let x = resLineAt[f]!; x < resLineAt[f + 1]!; x++) {
      put(`${resLineNo[x]!}\t${try new TextDecoder().decode(resLineText[x]!)}\n`)
    }
  }
  out.push(u8(10))
  writeOut(out)
}

// Writes the answer to one query line: score, tab and path per hit, then an
// empty line.
function answer(line: string): void throws Error {
  out = []
  let q = emptyQuery()
  try {
    q = parse(line)
  } catch (e) {
    // Named here, not through enc(): the modules may use TextEncoder only
    // when the entry module names it (tov/bugs/codec-entry-only).
    writeOut(new TextEncoder().encode("error\n\n"))
    return
  }
  if (q.hasGrep) {
    try answerGrep(q)
    return
  }
  if (deadCount === 0 && overCount === 0 && q.pathRe === "") {
    search(q)
    for (let j = 0; j < topScore.length; j++) {
      for (const c of enc(`${topScore[j]!}\t`)) {
        out.push(c)
      }
      putPath(topIdx[j]!, &out)
      out.push(u8(10))
    }
  } else {
    liveSearch(q)
    for (let j = 0; j < hitScore.length; j++) {
      for (const c of enc(`${hitScore[j]!}\t`)) {
        out.push(c)
      }
      for (const c of hitPath(hitIdx[j]!)) {
        out.push(c)
      }
      out.push(u8(10))
    }
  }
  out.push(u8(10))
  writeOut(out)
}

function main(): void throws Error {
  const me = process.argv[0]!.split("/")
  const args = process.argv.slice(2)
  if (!me[me.length - 1]!.startsWith("engine")) {
    try cli(args)
    return
  }
  if (args.length < 1) {
    throw new Error("usage: engine <disk-file> [home [linux]]")
  }
  if (args.length > 1) {
    setHome(args[1]!)
  }
  setLinuxPriors(args.length > 2 && args[2] === "linux")
  try readDisk(args[0]!)
  try build()
  namesAlloc()
  memosAlloc()
  extIndexBuild()
  liveReset([])
  process.stdout.write("ready\n")
  for (;;) {
    const line = readLine()
    if (line === "\n") {
      break
    }
    // Not a query (tools/livecheck.py): bring a folder in line with the disk.
    if (line.startsWith("!apply ")) {
      applyDir(enc(line.slice(7)), false)
      writeOut(enc("\n"))
      continue
    }
    // Not a query (tools/grepcheck.py): index home's file contents into a
    // new content index there.
    if (line.startsWith("!content ")) {
      contentOpen(line.slice(9), true)
      writeOut(enc(`${syncNow(enc(home), [], [enc(home)])}\n\n`))
      continue
    }
    try answer(line)
  }
}
