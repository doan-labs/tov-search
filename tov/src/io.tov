// The operating system calls Tov has no API for. Each is a raw hook: its C
// body in kernels/io/ replaces the Tov stub below, and does the one call.

// hook(raw): one query line without its "\n", or "\n" at EOF. Flushes stdout first.
export function readLine(): string {
  return "\n"
}

// hook(raw): writes bytes to stdout as they are, after anything buffered.
export function writeOut(data: u8[]): void {
  return
}

// hook(raw): writes data to path through a temporary file and a rename, so a
// reader never sees half a file. Returns "" or the error.
export function writeFile(path: string, data: u8[]): string {
  return ""
}

// hook(raw): listens on the unix socket sock, unless another process holds
// the lock file lock. Returns "" or the error.
export function sockListen(sock: string, lock: string): string {
  return ""
}

// hook(raw): waits up to timeoutMs (-1: no limit) for the next request line
// on any connection to the socket, accepting new ones meanwhile: the
// connection (u32) then the line, without its "\n". Connection 0xFFFFFFFF:
// file events are waiting (watchTake); 0xFFFFFFFE: the time ran out.
export function sockNext(timeoutMs: int): string {
  return ""
}

// hook(raw): writes data to connection conn (from sockNext).
export function sockReply(conn: int, data: u8[]): void {
  return
}

// hook(raw): sends line to the socket and returns the reply line; "" if
// nothing listens there.
export function sockAsk(sock: string, line: string): string {
  return ""
}

// hook(raw): starts this program as `serve` in its own session, output to
// log, then waits up to 3 s for it to listen on sock. Returns "" or the error.
export function spawnServe(log: string, sock: string): string {
  return ""
}

// hook(raw): runs a program (args[0], found on PATH) and returns its exit
// status, -1 if it could not start. quiet sends its stderr nowhere.
export function runCmd(args: string[], quiet: bool): int {
  return -1
}

// hook(raw): copies this program's file to dst (replacing, not overwriting:
// a running or signed binary may sit there). Returns "" or the error.
export function copySelf(dst: string): string {
  return ""
}

// hook(raw): starts watching the disk for changes, reported per folder.
// macOS: an FSEvents stream on / from event id since, replacing the last
// one; returns its number. Linux: inotify, once (since unused); folders are
// watched with watchAdd, and new ones as they appear (except under skip:
// u32 length + path each); returns -1 if inotify is unavailable.
export function watchStart(since: int, skip: u8[]): int {
  return 0
}

// hook(raw): the folders watched for changes, added (Linux; nothing on
// macOS, which watches the whole disk). req: u32 length + path each.
// Returns how many folders could not be watched so far (the watch limit).
export function watchAdd(req: u8[]): int {
  return 0
}

// hook(raw): the change events since the last call, each flags u32 |
// stream u32 | id u64 | path length u32 | path. Flags as FSEvents': 1 must
// scan subfolders, 2 dropped before read, 4 dropped by the kernel, 16
// history done.
export function watchTake(): string {
  return ""
}

// hook(raw): the newest event id now (macOS: FSEvents'; Linux: the time in ns).
export function eventNow(): int {
  return 0
}

// hook(raw): kind u8 | size u64 | mtime u32 of path (not following a
// link), or "" if there is nothing there.
export function lstatOne(path: u8[]): string {
  return ""
}

// hook(raw): per path in req (u32 length + path each), one byte: 1 if it
// exists and was modified at or after since. Checked on every core.
export function mtimesSince(req: u8[], since: int): string {
  return ""
}

// hook(raw): replaces this process with this program's `serve` (its files
// and sockets close, its lock goes with them). Returns only on failure, with
// the error.
export function execServe(): string {
  return ""
}

// hook(raw): this process's user id.
export function uid(): int {
  return 0
}

// hook(raw): sleeps ms milliseconds.
export function sleepMs(ms: int): void {
  return
}
